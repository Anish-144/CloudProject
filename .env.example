# CloudGuard Environment Configuration
# -------------------------------------------------------
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env — it is listed in .gitignore.
# -------------------------------------------------------

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cloudguard
POSTGRES_USER=cloudguard_user
POSTGRES_PASSWORD=cloudguard_secret_2024

DATABASE_URL=postgresql://cloudguard_user:cloudguard_secret_2024@postgres:5432/cloudguard

# JWT
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Services
GATEWAY_HOST=gateway
GATEWAY_PORT=8000
ALERT_SERVICE_URL=http://alert_service:8003

# App
APP_ENV=development
LOG_LEVEL=INFO

# AWS Credentials — fill in your own keys
AWS_ACCESS_KEY_ID=your-aws-access-key-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-key-here
AWS_DEFAULT_REGION=ap-south-1

# Mode: simulated | aws_live | hybrid
DATA_SOURCE_MODE=aws_live
